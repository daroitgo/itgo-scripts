#!/usr/bin/env bash
set -u

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  while [ -L "$SCRIPT_PATH" ]; do
    link_target="$(readlink "$SCRIPT_PATH")"
    case "$link_target" in
      /*) SCRIPT_PATH="$link_target" ;;
      *) SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/${link_target}" ;;
    esac
  done
fi

SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BASE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ITGO_HOME="$(cd "${BASE_DIR}/../.." && pwd)"
COLLECTOR="${BASE_DIR}/bin/collect_inventory.py"
REPORTS_DIR="${BASE_DIR}/reports"
LOGS_DIR="${BASE_DIR}/logs"
VERSION_FILE="${BASE_DIR}/inventory.version"
IDENTITY_FILE="${ITGO_HOME}/UTILITY/ITGO-CONFIG/client-identity.json"
CONFIG_DIR="${BASE_DIR}/config"
NEXTCLOUD_CONF="${CONFIG_DIR}/nextcloud.conf"
NEXTCLOUD_CRED="${CONFIG_DIR}/nextcloud.cred"

usage() {
  cat <<'EOF'
Usage: itgo-inv [collect|latest|version|configure-nextcloud|test-nextcloud|help]

Commands:
  collect   Generate an offline inventory JSON report
  latest    Show the newest local inventory report
  version   Show module and collector versions
  configure-nextcloud  Configure Nextcloud WebDAV upload
  test-nextcloud       Test configured Nextcloud WebDAV access
  help      Show this help
EOF
}

safe_filename_part() {
  local value="${1:-unknown}"
  value="$(printf '%s' "$value" | tr -c 'A-Za-z0-9._-' '_' | sed 's/_\+/_/g; s/^_//; s/_$//')"
  if [ -z "$value" ]; then
    value="unknown"
  fi
  printf '%s' "$value"
}

python_command() {
  local candidate
  for candidate in python3 python3.11 python3.9 python3.8 python3.7 python3.6 python python2 python2.7; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

read_client_code() {
  local code="unknown"
  local py_cmd

  if [ -f "$IDENTITY_FILE" ]; then
    if py_cmd="$(python_command)"; then
      code="$("$py_cmd" -c 'import io
import json
import sys
try:
    string_types = (basestring,)
except NameError:
    string_types = (str,)
try:
    with io.open(sys.argv[1], "r", encoding="utf-8") as fh:
        data = json.load(fh)
    value = data.get("client_code", "unknown")
    print(value if isinstance(value, string_types) and value else "unknown")
except Exception:
    print("unknown")
' "$IDENTITY_FILE" 2>/dev/null)"
    else
      code="$(sed -n 's/.*"client_code"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$IDENTITY_FILE" 2>/dev/null | head -n 1)"
      if [ -z "$code" ]; then
        code="unknown"
      fi
    fi
  fi

  safe_filename_part "$code"
}

has_cr_or_lf() {
  case "$1" in
    *$'\r'*|*$'\n'*) return 0 ;;
    *) return 1 ;;
  esac
}

nextcloud_configuration_state() {
  if [ -f "$NEXTCLOUD_CONF" ] && [ -f "$NEXTCLOUD_CRED" ]; then
    return 0
  fi
  if [ ! -e "$NEXTCLOUD_CONF" ] && [ ! -e "$NEXTCLOUD_CRED" ]; then
    return 2
  fi
  printf 'ERROR: incomplete Nextcloud configuration; both nextcloud.conf and nextcloud.cred are required.\n' >&2
  return 1
}

curl_config_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

url_encode_nextcloud_user() {
  local py_cmd

  py_cmd="$(python_command)" || return 1
  "$py_cmd" -c 'import sys
try:
    from urllib.parse import quote
except ImportError:
    from urllib import quote
print(quote(sys.argv[1], safe=""))
' "$1"
}

load_nextcloud_config() {
  local key value

  NEXTCLOUD_URL=""
  NEXTCLOUD_USER=""
  CREDENTIAL_MODE=""

  [ -f "$NEXTCLOUD_CONF" ] || {
    printf 'ERROR: Nextcloud WebDAV is not configured: %s\n' "$NEXTCLOUD_CONF" >&2
    return 1
  }
  [ -f "$NEXTCLOUD_CRED" ] || {
    printf 'ERROR: Nextcloud credential is missing: %s\n' "$NEXTCLOUD_CRED" >&2
    return 1
  }

  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      NEXTCLOUD_URL) NEXTCLOUD_URL="$value" ;;
      NEXTCLOUD_USER) NEXTCLOUD_USER="$value" ;;
      CREDENTIAL_MODE) CREDENTIAL_MODE="$value" ;;
      ''|'#'*) ;;
    esac
  done < "$NEXTCLOUD_CONF"

  if [ -z "$NEXTCLOUD_URL" ] || [ -z "$NEXTCLOUD_USER" ] || [ -z "$CREDENTIAL_MODE" ] \
    || has_cr_or_lf "$NEXTCLOUD_URL" || has_cr_or_lf "$NEXTCLOUD_USER" || has_cr_or_lf "$CREDENTIAL_MODE"; then
    printf 'ERROR: invalid Nextcloud configuration.\n' >&2
    return 1
  fi
  case "$CREDENTIAL_MODE" in
    systemd-creds|plain-0600) ;;
    *)
      printf 'ERROR: unsupported Nextcloud credential mode.\n' >&2
      return 1
      ;;
  esac
}

read_nextcloud_credential() {
  NEXTCLOUD_PASSWORD=""

  case "$CREDENTIAL_MODE" in
    systemd-creds)
      NEXTCLOUD_PASSWORD="$(systemd-creds decrypt --user --name=nextcloud-password "$NEXTCLOUD_CRED" - 2>/dev/null)" || {
        printf 'ERROR: could not decrypt Nextcloud credential.\n' >&2
        return 1
      }
      ;;
    plain-0600)
      NEXTCLOUD_PASSWORD="$(cat -- "$NEXTCLOUD_CRED")" || {
        printf 'ERROR: could not read Nextcloud credential.\n' >&2
        return 1
      }
      ;;
  esac

  if [ -z "$NEXTCLOUD_PASSWORD" ] || has_cr_or_lf "$NEXTCLOUD_PASSWORD"; then
    unset NEXTCLOUD_PASSWORD
    printf 'ERROR: invalid Nextcloud credential.\n' >&2
    return 1
  fi
}

nextcloud_curl() {
  local method="$1" url="$2" upload_path="${3:-}" http_status curl_status

  http_status="$({
    printf 'user = "%s"\n' "$(curl_config_escape "${NEXTCLOUD_USER}:${NEXTCLOUD_PASSWORD}")"
    printf 'request = "%s"\n' "$(curl_config_escape "$method")"
    case "$method" in
      PROPFIND) printf 'header = "Depth: 0"\n' ;;
      PUT) printf 'header = "If-None-Match: *"\n' ;;
    esac
    printf 'fail\nsilent\nshow-error\noutput = "/dev/null"\n'
    if [ -n "$upload_path" ]; then
      printf 'upload-file = "%s"\n' "$(curl_config_escape "$upload_path")"
    fi
    printf 'url = "%s"\n' "$(curl_config_escape "$url")"
    printf 'write-out = "%%{http_code}"\n'
  } | curl --config -)"
  curl_status=$?
  if [ "$curl_status" -ne 0 ]; then
    return 1
  fi

  case "${method}:${http_status}" in
    PROPFIND:207|PUT:200|PUT:201|PUT:204) return 0 ;;
    *)
      printf 'ERROR: unexpected WebDAV HTTP status %s for %s.\n' "${http_status:-unknown}" "$method" >&2
      return 1
      ;;
  esac
}

nextcloud_preflight() {
  local client_code="$1" encoded_user

  load_nextcloud_config || return 1
  command -v curl >/dev/null 2>&1 || {
    printf 'ERROR: curl is required for Nextcloud WebDAV.\n' >&2
    return 1
  }
  read_nextcloud_credential || return 1
  encoded_user="$(url_encode_nextcloud_user "$NEXTCLOUD_USER")" || {
    unset NEXTCLOUD_PASSWORD
    printf 'ERROR: could not URL-encode Nextcloud user.\n' >&2
    return 1
  }
  NEXTCLOUD_REMOTE_DIR="INVENTORY/${client_code}/"
  NEXTCLOUD_DAV_DIR_URL="${NEXTCLOUD_URL}/remote.php/dav/files/${encoded_user}/${NEXTCLOUD_REMOTE_DIR}"

  if ! nextcloud_curl PROPFIND "$NEXTCLOUD_DAV_DIR_URL"; then
    unset NEXTCLOUD_PASSWORD
    return 1
  fi
  unset NEXTCLOUD_PASSWORD
}

nextcloud_upload_report() {
  local client_code="$1" report_name="$2" report_path="$3" encoded_user report_url

  load_nextcloud_config || return 1
  read_nextcloud_credential || return 1
  encoded_user="$(url_encode_nextcloud_user "$NEXTCLOUD_USER")" || {
    unset NEXTCLOUD_PASSWORD
    return 1
  }
  report_url="${NEXTCLOUD_URL}/remote.php/dav/files/${encoded_user}/INVENTORY/${client_code}/${report_name}"

  if ! nextcloud_curl PUT "$report_url" "$report_path"; then
    unset NEXTCLOUD_PASSWORD
    return 1
  fi
  if ! nextcloud_curl PROPFIND "$report_url"; then
    unset NEXTCLOUD_PASSWORD
    return 1
  fi
  unset NEXTCLOUD_PASSWORD
  return 0
}

configure_nextcloud() {
  local url="" user="" password="" encrypted="" recovered="" cred_tmp="" config_tmp="" credential_mode=""

  read -r -p 'Nextcloud URL: ' url || true
  read -r -p 'Nextcloud technical user: ' user || true
  read -r -s -p 'Nextcloud App Password: ' password || true
  printf '\n'

  while [ "${url%/}" != "$url" ]; do url="${url%/}"; done
  if [ -z "$url" ] || [ -z "$user" ] || [ -z "$password" ] \
    || has_cr_or_lf "$url" || has_cr_or_lf "$user" || has_cr_or_lf "$password"; then
    unset password encrypted recovered
    printf 'ERROR: URL, user and App Password must be non-empty and must not contain CR/LF.\n' >&2
    return 1
  fi

  if ! mkdir -p "$CONFIG_DIR" || ! chmod 0700 "$CONFIG_DIR"; then
    unset password encrypted recovered
    return 1
  fi
  cred_tmp="${CONFIG_DIR}/.nextcloud.cred.tmp.$$"
  config_tmp="${CONFIG_DIR}/.nextcloud.conf.tmp.$$"
  credential_mode="plain-0600"
  if command -v systemd-creds >/dev/null 2>&1; then
    encrypted="$(printf '%s' "$password" | systemd-creds encrypt --user --name=nextcloud-password - - 2>/dev/null)" || encrypted=""
    if [ -n "$encrypted" ]; then
      recovered="$(printf '%s' "$encrypted" | systemd-creds decrypt --user --name=nextcloud-password - - 2>/dev/null)" || recovered=""
      if [ "$recovered" = "$password" ]; then
        credential_mode="systemd-creds"
      else
        encrypted=""
      fi
      unset recovered
    fi
  fi

  if [ "$credential_mode" = "systemd-creds" ]; then
    (umask 077; printf '%s\n' "$encrypted" > "$cred_tmp") && chmod 0600 "$cred_tmp" || {
      rm -f -- "$cred_tmp" "$config_tmp"
      unset password encrypted recovered
      return 1
    }
  else
    (umask 077; printf '%s' "$password" > "$cred_tmp") && chmod 0600 "$cred_tmp" || {
      rm -f -- "$cred_tmp" "$config_tmp"
      unset password encrypted recovered
      return 1
    }
  fi

  (umask 077; {
    printf 'NEXTCLOUD_URL=%s\n' "$url"
    printf 'NEXTCLOUD_USER=%s\n' "$user"
    printf 'CREDENTIAL_MODE=%s\n' "$credential_mode"
  } > "$config_tmp") && chmod 0600 "$config_tmp" || {
    rm -f -- "$cred_tmp" "$config_tmp"
    unset password encrypted recovered
    return 1
  }

  if ! mv -f -- "$cred_tmp" "$NEXTCLOUD_CRED" || ! mv -f -- "$config_tmp" "$NEXTCLOUD_CONF"; then
    rm -f -- "$cred_tmp" "$config_tmp"
    unset password encrypted recovered
    return 1
  fi
  if [ "$credential_mode" = "plain-0600" ]; then
    printf 'WARNING: user-scoped systemd-creds is unavailable; App Password is protected only by filesystem mode 0600.\n' >&2
  fi
  unset password encrypted recovered
  printf 'Nextcloud WebDAV configuration saved. Credential mode: %s\n' "$credential_mode"
}

test_nextcloud() {
  local client_code

  client_code="$(read_client_code)"
  if [ "$client_code" = "unknown" ]; then
    printf 'ERROR: valid client_code is unavailable; cannot test Nextcloud WebDAV.\n' >&2
    return 1
  fi
  if ! nextcloud_preflight "$client_code"; then
    printf 'ERROR: Nextcloud WebDAV preflight failed.\n' >&2
    return 1
  fi
  printf 'URL: %s\nUser: %s\nClient code: %s\nRemote directory: INVENTORY/%s/\nCredential mode: %s\nSUCCESS: Nextcloud WebDAV preflight passed.\n' \
    "$NEXTCLOUD_URL" "$NEXTCLOUD_USER" "$client_code" "$client_code" "$CREDENTIAL_MODE"
}

collector_has_output_option() {
  [ -f "$COLLECTOR" ] && grep -Eq -- '(^|[^A-Za-z0-9_-])--output([^A-Za-z0-9_-]|$)' "$COLLECTOR"
}

run_collector() {
  local output_path="$1"
  local log_path="$2"
  local py_cmd

  if ! py_cmd="$(python_command)"; then
    printf 'error: no working Python interpreter found; tried python3, python3.11, python3.9, python3.8, python3.7, python3.6, python, python2, python2.7\n' >&2
    return 1
  fi

  if collector_has_output_option; then
    "$py_cmd" "$COLLECTOR" --output "$output_path" >>"$log_path" 2>&1
  else
    "$py_cmd" "$COLLECTOR" >"$output_path" 2>>"$log_path"
  fi
}

reports_dir_is_safe() {
  local reports_real base_real parent_real

  [ -n "${REPORTS_DIR:-}" ] || return 1
  [ -n "${BASE_DIR:-}" ] || return 1

  reports_real="$(cd "$REPORTS_DIR" 2>/dev/null && pwd -P)" || return 1
  base_real="$(cd "$BASE_DIR" 2>/dev/null && pwd -P)" || return 1
  parent_real="$(cd "${BASE_DIR}/.." 2>/dev/null && pwd -P)" || return 1

  case "$reports_real" in
    ""|"/"|"/root"|"/root/"*) return 1 ;;
  esac

  [ "$reports_real" = "${base_real}/reports" ] || return 1
  [ "$(basename "$reports_real")" = "reports" ] || return 1
  [ "$(basename "$base_real")" = "INVENTORY" ] || return 1
  [ "$(basename "$parent_real")" = "UTILITY" ] || return 1

  return 0
}

clean_old_inventory_reports() {
  local current_temp_path="${1:-}" reports_real current_temp_real current_temp_dir

  if ! reports_dir_is_safe; then
    printf 'error: refusing to clean unsafe inventory reports directory: %s\n' "$REPORTS_DIR" >&2
    return 1
  fi

  reports_real="$(cd "$REPORTS_DIR" 2>/dev/null && pwd -P)" || return 1

  if [ -n "$current_temp_path" ]; then
    current_temp_dir="$(dirname "$current_temp_path")"
    current_temp_real="$(cd "$current_temp_dir" 2>/dev/null && pwd -P)/$(basename "$current_temp_path")" || return 1
    case "$current_temp_real" in
      "$reports_real"/.inventory_*.json.tmp.*) ;;
      *)
        printf 'error: refusing to preserve temp file outside inventory reports directory: %s\n' "$current_temp_path" >&2
        return 1
        ;;
    esac
  fi

  if [ -n "$current_temp_path" ]; then
    find "$reports_real" -maxdepth 1 -type f -name '.inventory_*.json.tmp.*' -exec sh -c '
      current_temp="$1"
      shift
      for candidate_path in "$@"; do
        [ "$candidate_path" = "$current_temp" ] || rm -f -- "$candidate_path"
      done
    ' sh "$current_temp_real" {} +
  else
    find "$reports_real" -maxdepth 1 -type f -name '.inventory_*.json.tmp.*' -exec rm -f -- {} \;
  fi
}

collect_report() {
  local client_code hostname timestamp report_name report_path temp_path log_path nextcloud_ready=0 collision_index=0 nextcloud_state

  if [ ! -f "$COLLECTOR" ]; then
    printf 'error: collector not found: %s\n' "$COLLECTOR" >&2
    return 1
  fi

  mkdir -p "$REPORTS_DIR" "$LOGS_DIR" || {
    printf 'error: could not create reports/logs directories\n' >&2
    return 1
  }

  if ! reports_dir_is_safe; then
    printf 'error: unsafe inventory reports directory: %s\n' "$REPORTS_DIR" >&2
    return 1
  fi

  client_code="$(read_client_code)"
  if [ "$client_code" = "unknown" ]; then
    printf 'WARNING: valid client_code is unavailable; Nextcloud upload is disabled.\n' >&2
    printf 'Inventory will be generated locally and preserved.\n' >&2
  else
    nextcloud_configuration_state
    nextcloud_state=$?
    case "$nextcloud_state" in
      0)
        if nextcloud_preflight "$client_code"; then
          nextcloud_ready=1
        else
          printf 'WARNING: Nextcloud WebDAV preflight failed.\n' >&2
          printf 'Inventory will be generated locally and preserved.\n' >&2
        fi
        ;;
      2)
        printf 'WARNING: automatic Nextcloud upload is not configured.\n' >&2
        printf 'Inventory will be generated locally and preserved.\n' >&2
        ;;
      *)
        printf 'WARNING: Nextcloud WebDAV preflight failed.\n' >&2
        printf 'Inventory will be generated locally and preserved.\n' >&2
        ;;
    esac
  fi
  hostname="$(safe_filename_part "$(hostname 2>/dev/null || printf 'unknown')")"
  timestamp="$(date '+%Y%m%d_%H%M%S')"
  report_name="inventory_${client_code}_${hostname}_${timestamp}.json"
  report_path="${REPORTS_DIR}/${report_name}"
  while [ -e "$report_path" ]; do
    collision_index=$((collision_index + 1))
    report_name="inventory_${client_code}_${hostname}_${timestamp}_${collision_index}.json"
    report_path="${REPORTS_DIR}/${report_name}"
  done
  temp_path="${REPORTS_DIR}/.${report_name}.tmp.$$"
  log_path="${LOGS_DIR}/inventory_${timestamp}.log"

  rm -f "$temp_path"

  if ! run_collector "$temp_path" "$log_path"; then
    rm -f "$temp_path"
    printf 'error: inventory report generation failed\n' >&2
    printf 'log: %s\n' "$log_path" >&2
    return 1
  fi

  if [ ! -s "$temp_path" ]; then
    rm -f "$temp_path"
    printf 'error: inventory collector produced an empty report\n' >&2
    printf 'log: %s\n' "$log_path" >&2
    return 1
  fi

  if ! clean_old_inventory_reports "$temp_path"; then
    rm -f "$temp_path"
    printf 'log: %s\n' "$log_path" >&2
    return 1
  fi

  mv "$temp_path" "$report_path" || {
    rm -f "$temp_path"
    printf 'error: could not save inventory report\n' >&2
    printf 'log: %s\n' "$log_path" >&2
    return 1
  }

  chmod 0600 "$report_path" 2>/dev/null || true
  printf 'Inventory report: %s\n' "$report_path"

  if [ "$nextcloud_ready" = "1" ]; then
    if nextcloud_upload_report "$client_code" "$report_name" "$report_path"; then
      printf 'SUCCESS: inventory report uploaded to Nextcloud.\n'
      printf 'Remote: INVENTORY/%s/%s\n' "$client_code" "$report_name"
      if rm -f -- "$report_path" && [ ! -e "$report_path" ]; then
        printf 'Local report removed after verified upload.\n'
      else
        printf 'WARNING: inventory upload was verified, but the local report could not be removed.\n' >&2
        printf 'Local report preserved: %s\n' "$report_path" >&2
      fi
    else
      printf 'WARNING: inventory upload to Nextcloud failed.\n' >&2
      printf 'Local report preserved: %s\n' "$report_path" >&2
    fi
  else
    printf 'Local report preserved: %s\n' "$report_path" >&2
  fi
}

show_latest() {
  local latest

  if [ ! -d "$REPORTS_DIR" ]; then
    printf 'No inventory reports found in %s\n' "$REPORTS_DIR"
    return 1
  fi

  latest="$(find "$REPORTS_DIR" -maxdepth 1 -type f -name 'inventory_*.json' -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk 'NR == 1 {sub(/^[^ ]+ /, ""); print}')"
  if [ -z "$latest" ]; then
    printf 'No inventory reports found in %s\n' "$REPORTS_DIR"
    return 1
  fi

  printf '%s\n' "$latest"
}

show_version() {
  local inventory_version="unknown"
  local collector_version="unknown"

  if [ -f "$VERSION_FILE" ]; then
    # shellcheck disable=SC1090
    . "$VERSION_FILE"
    inventory_version="${INVENTORY_VERSION:-unknown}"
    collector_version="${COLLECTOR_VERSION:-unknown}"
  fi

  printf 'Inventory module: %s\n' "$inventory_version"
  printf 'Inventory collector: %s\n' "$collector_version"
}

command_name="${1:-collect}"

case "$command_name" in
  collect)
    collect_report
    ;;
  latest)
    show_latest
    ;;
  version)
    show_version
    ;;
  configure-nextcloud)
    configure_nextcloud
    ;;
  test-nextcloud)
    test_nextcloud
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
